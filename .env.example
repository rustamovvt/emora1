# Runtime
PORT=8787
NODE_ENV=development
APP_URL=http://localhost:8787
BASE_DOMAIN=emora.uz
DEMO_MODE=true
ADMIN_TOKEN=change-me-long-random-token

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# PostgreSQL (recommended production). If empty, local data/db.json is used.
DATABASE_URL=
PGSSL=require
PG_POOL_MAX=10

# Cloudflare R2 (all values required to switch from local uploads to R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=emora-media
R2_PUBLIC_BASE_URL=

# External web merchant checkout (outside Telegram Mini App)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
